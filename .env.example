# =============================================================================
# OpenCorp - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- LLM Provider ---
# OpenRouter is the default provider for the MVP.
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: Set a default model for OpenRouter
# Default: openai/gpt-4o-mini
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Optional: OpenRouter base URL (change only if using a custom endpoint)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Database ---
# SQLite is the default for local-first development.
# The path is relative to the prisma/ directory.
DATABASE_URL=file:./opencorp.db

# --- Application ---
# The port for the Next.js web application
# Default: 3000
# PORT=3000

# The port for the API server (if separate from Next.js)
# Default: 4000
# API_PORT=4000

# --- Docker Sandbox ---
# The Docker image to use for agent workspaces
# Default: opencorp-sandbox:latest
# WORKSPACE_IMAGE=opencorp-sandbox:latest

# --- Logging ---
# Log level: debug, info, warn, error
# Default: info
# LOG_LEVEL=info