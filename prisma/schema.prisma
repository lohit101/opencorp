// =============================================================================
// OpenCorp - Prisma Schema (SQLite)
// =============================================================================
// This schema defines the database structure for the local-first MVP.
// SQLite is used for initial development; PostgreSQL can be added later.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Company
// ---------------------------------------------------------------------------

model Company {
  id          String   @id @default(uuid())
  name        String
  description String
  objective   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agents      Agent[]
  tasks       Task[]
  memories    Memory[]
  events      SystemEvent[]
  messages    Message[]
  workspaces  Workspace[]
}

// ---------------------------------------------------------------------------
// Agent
// ---------------------------------------------------------------------------

model Agent {
  id            String   @id @default(uuid())
  companyId     String
  name          String
  role          String
  description   String
  modelProvider String   @default("openrouter")
  modelName     String   @default("openai/gpt-4o-mini")
  systemPrompt  String
  skillIds      String   @default("[]") // JSON array of skill IDs
  toolNames     String   @default("[]") // JSON array of tool names
  permissions   String   @default("{}") // JSON permissions object
  state         String   @default("idle")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sentMessages  Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  assignedTasks Task[]
}

// ---------------------------------------------------------------------------
// Task
// ---------------------------------------------------------------------------

model Task {
  id              String    @id @default(uuid())
  companyId       String
  title           String
  description     String
  status          String    @default("pending")
  assignedAgentId String?
  parentTaskId    String?
  priority        Int       @default(1)
  result          String?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedAgent   Agent?    @relation(fields: [assignedAgentId], references: [id])
  parentTask      Task?     @relation("ChildTasks", fields: [parentTaskId], references: [id])
  childTasks      Task[]    @relation("ChildTasks")
  messages        Message[]
}

// ---------------------------------------------------------------------------
// Message
// ---------------------------------------------------------------------------

model Message {
  id                String   @id @default(uuid())
  companyId         String
  senderAgentId     String
  recipientAgentId  String?
  taskId            String?
  content           String
  timestamp         DateTime @default(now())

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sender            Agent    @relation("SentMessages", fields: [senderAgentId], references: [id])
  recipient         Agent?   @relation("ReceivedMessages", fields: [recipientAgentId], references: [id])
  task              Task?    @relation(fields: [taskId], references: [id])
}

// ---------------------------------------------------------------------------
// Memory
// ---------------------------------------------------------------------------

model Memory {
  id            String   @id @default(uuid())
  companyId     String
  type          String   @default("company")
  key           String
  content       String
  tags          String   @default("[]") // JSON array of tags
  sourceAgentId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// System Event
// ---------------------------------------------------------------------------

model SystemEvent {
  id        String   @id @default(uuid())
  companyId String
  type      String
  agentId   String?
  taskId    String?
  data      String   @default("{}") // JSON data
  timestamp DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Workspace
// ---------------------------------------------------------------------------

model Workspace {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  path        String
  containerId String?
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}